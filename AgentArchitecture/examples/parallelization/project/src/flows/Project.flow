{"id": "summarizerNode_lT2H3KPXJkRE", "type": "summarizerNode", "position": {"x": 800, "y": 3104},
 "data": {"label": "", "description": "", "labelNode": "Summarizer", "descriptionNode": "Writes the chat summary for an LLM node's Summary output", "openLLM": false, "openPrompt": false,
  "settings": {
   "sessionId": "", "requestId": "",
   "llm": {"company": "anthropic", "model": "claude-haiku-4-5-20251001", "modelId": 4939, "parameters": {"temperature": 0.2, "maxTokens": 1500}},
   "prompts": [
    {"id": "dca35a21-6e7f-4e8f-ae7f-db486ead8bfd", "role": "system", "content": "You maintain a running summary of a conversation between a user and an AI agent.\nYou receive the previous summary (or \"(none)\") and the newest part of the conversation.\nWrite the updated summary of the WHOLE conversation so far.\n\nKeep: facts the user stated, decisions made, names, numbers, dates, identifiers, the user's preferences and\nconstraints, tasks done, and open questions or promised next steps.\nDrop: greetings, small talk, repetition, and wording that adds nothing.\nWrite in the language of the conversation. Be concise: plain short sentences or bullets, no headings.\nNever invent anything that is not in the conversation. If something changed, keep the newest version.\nReturn only the summary text."}
   ]
  }},
 "dragHandle": ".drag-handle__custom"},
{"id": "summarizerNode_GrdZr4usn6I9", "type": "summarizerNode", "position": {"x": 1296, "y": 3104},
 "data": {"label": "", "description": "", "labelNode": "Summarizer", "descriptionNode": "Writes the chat summary for an LLM node's Summary output", "openLLM": false, "openPrompt": false,
