{"id": "agentNode_zlYfI0yzrDJI", "type": "agentNode", "position": {"x": 304, "y": 3104},
 "data": {"label": "", "description": "The answering node (console agent ID): combines everything for the seller", "labelNode": "LLM", "descriptionNode": "Use LLM processor", "open": false, "openLLM": false, "openPrompt": false,
  "settings": {
   "agentId": "listing-reviewer", "agentName": "Listing Reviewer", "sessionId": "", "requestId": "",
   "llm": {"company": "anthropic", "model": "claude-sonnet-4-6", "modelId": 4938, "parameters": {"temperature": 0.3, "maxTokens": 2048}},
   "prompts": [
    {"id": "p0", "role": "system", "content": "You review listings for Tradepost, a fictional second-hand marketplace. Write the seller a short review of the listing they sent, in their language, at most 180 words: first the verdict (publish or hold) and why, then what to fix, then the suggested title. Use only the report below. If the report is empty, say the review could not run and ask the seller to send the listing again.\n\nReport:\n${dictionary.report}"}
   ],
   "specialRules": [{"type": "skip-internal-tooling"}]
  }},
 "dragHandle": ".drag-handle__custom"},
